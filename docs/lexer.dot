digraph lexer {
    rankdir=LR;
    node [shape=circle];
    F_CONS [shape=doublecircle];
    F_RET [shape=doublecircle];
    E [shape=box, color=red];
    "0" -> "1" [label="L, i, s / sa_init"];
    "0" -> "5" [label="D / sa_init"];
    "0" -> "E" [label="_, $, other / sa_error"];
    "0" -> "7" [label=". / sa_init"];
    "0" -> "F_CONS" [label="+-, op*() / sa_token_consume"];
    "0" -> "2" [label="/ / sa_init"];
    "0" -> "13" [label="= / sa_init"];
    "0" -> "14" [label="<> / sa_init"];
    "0" -> "4" [label="!: / sa_init"];
    "0" -> "12" [label="\" / sa_init_chain"];
    "0" -> "0" [label="nl, ws / sa_ignore"];
    "1" -> "1" [label="L, i, s, D, _ / sa_append"];
    "1" -> "F_RET" [label="., $, +-, /, op*(), =, <>, !:, \", nl, ws, other / sa_identifier"];
    "2" -> "F_RET" [label="L, i, s, D, _, ., $, +-, op*(), =, <>, !:, \", nl, ws, other / sa_token_buffered"];
    "2" -> "3" [label="/ / sa_ignore"];
    "3" -> "3" [label="L, i, s, D, _, ., $, +-, /, op*(), =, <>, !:, \", ws, other / sa_ignore"];
    "3" -> "0" [label="nl / sa_ignore"];
    "4" -> "E" [label="L, i, s, D, _, ., $, +-, /, op*(), <>, !:, \", nl, ws, other / sa_error"];
    "4" -> "F_CONS" [label="= / sa_multi_char_op"];
    "5" -> "E" [label="L, i, _, +-, /, op*(), =, <>, !:, \", nl, ws, other / sa_integer_literal_error"];
    "5" -> "E" [label="s / sa_float_decimal_error"];
    "5" -> "5" [label="D / sa_append"];
    "5" -> "7" [label=". / sa_append"];
    "5" -> "6" [label="$ / sa_append"];
    "6" -> "E" [label="L, s, D, _, ., $, +-, /, op*(), =, <>, !:, \", nl, ws, other / sa_integer_literal_error"];
    "6" -> "F_CONS" [label="i / sa_int_const"];
    "7" -> "F_RET" [label="L, i, s, _, ., $, +-, /, op*(), =, <>, !:, \", nl, ws, other / sa_dot_or_float_error"];
    "7" -> "8" [label="D / sa_append"];
    "8" -> "F_RET" [label="L, i, _, ., $, +-, /, op*(), =, <>, !:, \", nl, ws, other / sa_float_const"];
    "8" -> "9" [label="s / sa_append"];
    "8" -> "8" [label="D / sa_append"];
    "9" -> "E" [label="L, i, s, _, ., $, /, op*(), =, <>, !:, \", nl, ws, other / sa_float_exponent_error"];
    "9" -> "11" [label="D / sa_append"];
    "9" -> "10" [label="+- / sa_append"];
    "10" -> "E" [label="L, i, s, _, ., $, +-, /, op*(), =, <>, !:, \", nl, ws, other / sa_float_exponent_error"];
    "10" -> "11" [label="D / sa_append"];
    "11" -> "F_RET" [label="L, i, s, _, ., $, +-, /, op*(), =, <>, !:, \", nl, ws, other / sa_float_const"];
    "11" -> "11" [label="D / sa_append"];
    "12" -> "12" [label="L, i, s, D, _, ., $, +-, /, op*(), =, <>, !:, nl, ws, other / sa_append"];
    "12" -> "F_CONS" [label="\" / sa_chain"];
    "13" -> "F_RET" [label="L, i, s, D, _, ., $, +-, /, op*(), <>, !:, \", nl, ws, other / sa_token_buffered"];
    "13" -> "F_CONS" [label="= / sa_multi_char_op"];
    "14" -> "F_RET" [label="L, i, s, D, _, ., $, +-, /, op*(), <>, !:, \", nl, ws, other / sa_token_buffered"];
    "14" -> "F_CONS" [label="= / sa_multi_char_op"];
}
